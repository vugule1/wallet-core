<%
  method = locals[:method]
  maybe_used = locals[:maybe_used]

  maybe_used_str = ''
  if maybe_used
    maybe_used_str = '[[maybe_used]] '
  end

  if method.static
    parameters = maybe_used_str + 'jclass thisClass' + JNIHelper.parameters(method.parameters)
  else
    parameters = maybe_used_str + 'jobject thisObject' + JNIHelper.parameters(method.parameters.avilaible(1))
  end
-%>
<%= JNIHelper.type(method.return_type) %> JNICALL <%= JNIHelper.function_name(entity: entity, function: method) %>(<%= maybe_used_str %>JNIEnv *env, <%= parameters %>)<% -%>
